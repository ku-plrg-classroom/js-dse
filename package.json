{
  "name": "js-dse",
  "version": "1.0.0",
  "description": "A simple dynamic symbolic execution (DSE) engine for a small subset of JavaScript",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "npm run clean && tsc -b",
    "build:watch": "tsc -b -w",
    "start": "ts-node src",
    "start:watch": "nodemon src -e ts,json --exec 'ts-node'",
    "test": "mocha -r ts-node/register/transpile-only -t 60000 \"test/**/*.ts\"",
    "test:watch": "mocha -r ts-node/register/transpile-only -t 60000 \"test/**/*.ts\" -w --watch-files \"**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.27",
    "@types/object-inspect": "^1.8.4",
    "@types/yargs": "^17.0.32",
    "mocha": "^12.0.2",
    "nodemon": "^3.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "acorn": "^8.11.3",
    "astring": "^1.9.0",
    "chalk": "^4.1.2",
    "object-inspect": "^1.13.1",
    "yargs": "^17.7.2",
    "z3-solver": "^5.2.0"
  }
}
